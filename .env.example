# Notion 配置（必需）
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=xxxx

# GitHub 配置（可选）
GITHUB_TRENDING_API=
GITHUB_LIMIT=10

# 百度翻译配置（可选，用于翻译 GitHub 和 HackerNews）
BAIDU_FANYI_APP_ID=
BAIDU_FANYI_SECRET=

# DeepSeek AI 配置（可选，用于智能摘要）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_SUMMARY_ENABLED=false

# 数据源开关（可选，默认都开启）
WEIBO_ENABLED=true
HN_ENABLED=true
ZHIHU_ENABLED=true

# API URL 配置（可选，用于自定义数据源 API）
WEIBO_API_URL=https://tenapi.cn/v2/weibohot
WEIBO_API_BACKUP=https://api.oioweb.cn/api/common/weibo/hot
HN_API_URL=https://hacker-news.firebaseio.com/v0
ZHIHU_API_URL=https://tenapi.cn/v2/zhihuhot
ZHIHU_API_BACKUP=https://api.oioweb.cn/api/common/zhihu/hot

# 各数据源条目数量（可选）
NEWS_LIMIT=10
WEIBO_LIMIT=3
HN_LIMIT=3
ZHIHU_LIMIT=3

# HTTP 请求配置（可选）
REQUEST_TIMEOUT=10

# 调度时间（UTC，可选）
SCHEDULE_TIME=08:00
